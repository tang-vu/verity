# ============================================================================
# verity — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# Items marked [HUMAN] must be provided by you; everything else has a default.
# ============================================================================

# --- LLM (oracle signal generation) — DeepSeek (OpenAI-compatible) -----------
# [HUMAN] DeepSeek API key. Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Model + base URL. deepseek-chat is the cost-effective default; the API is
# OpenAI-compatible so any compatible endpoint works (set LLM_* to override).
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Casper network ----------------------------------------------------------
CASPER_CHAIN_NAME=casper-test
# Testnet JSON-RPC endpoint. Pick a healthy peer from
# https://testnet.cspr.live/tools/peers (port 7777, path /rpc).
# CSPR.cloud also exposes a hosted RPC (requires CSPR_CLOUD_ACCESS_TOKEN).
CASPER_NODE_RPC_URL=https://node.testnet.cspr.cloud/rpc
# Block explorer base (for printing clickable links)
CASPER_EXPLORER_BASE=https://testnet.cspr.live

# --- Keys (generated by scripts/generate-keypair.mjs) ------------------------
# [HUMAN ACTION] Producer key is generated locally, but the ACCOUNT must be
# FUNDED via the faucet at https://testnet.cspr.live (see docs/DEPLOYMENT.md).
PRODUCER_SECRET_KEY_PATH=./keys/producer_secret_key.pem
PRODUCER_PUBLIC_KEY_HEX=
PRODUCER_ACCOUNT_HASH=
# Consumer (DeFi agent) key — also generated locally; fund a small amount.
CONSUMER_SECRET_KEY_PATH=./keys/consumer_secret_key.pem
CONSUMER_PUBLIC_KEY_HEX=
CONSUMER_ACCOUNT_HASH=

# --- Deployed contract (filled after `cargo run --bin deploy`) ---------------
SIGNAL_ORACLE_CONTRACT_HASH=
SIGNAL_ORACLE_PACKAGE_HASH=
SIGNAL_ORACLE_DEPLOY_HASH=

# --- x402 paywall + facilitator ----------------------------------------------
# [HUMAN] CSPR.cloud access token — needed for the hosted facilitator AND the
# hosted RPC/MCP. Sign up + create a token at https://console.cspr.build/sign-up
# (passed as the `Authorization` header). Optional — see README for the public-RPC path.
CSPR_CLOUD_ACCESS_TOKEN=
# Hosted x402 facilitator (verify/settle). Gas is paid by the facilitator.
X402_FACILITATOR_URL=https://x402-facilitator.cspr.cloud
# CEP-18 token used as the x402 payment asset (package hash + metadata).
# On testnet, use the buildathon x402 demo token (see docs/DEPLOYMENT.md) or
# deploy your own CEP-18 via scripts/deploy-x402-token.
X402_ASSET_PACKAGE_HASH=
X402_ASSET_NAME=x402USD
X402_ASSET_SYMBOL=x402
X402_ASSET_DECIMALS=2
X402_ASSET_VERSION=1
# Price per "latest signal" read, in the asset's smallest unit (e.g. 10 = $0.10 at 2 decimals)
X402_PRICE=10
# CAIP-2 network id for the facilitator
X402_NETWORK=casper:casper-test

# --- Oracle x402 server ------------------------------------------------------
ORACLE_SERVER_PORT=4021
ORACLE_SERVER_URL=http://localhost:4021

# --- MCP servers -------------------------------------------------------------
# CSPR.trade MCP (DEX swap/rebalance). Streamable HTTP endpoint.
CSPR_TRADE_MCP_URL=https://mcp.cspr.trade/mcp
# Casper MCP (balances, deploys, contract reads). Optional discovery channel.
CASPER_MCP_URL=https://mcp.cspr.cloud/mcp

# --- Demo / agent behaviour --------------------------------------------------
# Signal subject. CoinGecko id + the pair we trade on CSPR.trade.
SIGNAL_ASSET=casper-network
SIGNAL_VS_CURRENCY=usd
# Notional size of the consumer's reputation-weighted action (asset smallest unit)
CONSUMER_MAX_NOTIONAL=1000
# Minimum reputation (0-10000 bps) below which the consumer refuses to act
CONSUMER_MIN_REPUTATION_BPS=4000
