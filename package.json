{
  "name": "verity",
  "version": "0.1.0",
  "private": true,
  "description": "Reputation-staked x402 signal oracle + autonomous DeFi agent loop on Casper",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "oracle-agent",
    "defi-agent",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "keygen": "node scripts/generate-keypair.mjs",
    "init-env": "node scripts/init-env.mjs",
    "build:wasm": "powershell -ExecutionPolicy Bypass -File scripts/build-wasm.ps1",
    "deploy:contract": "powershell -ExecutionPolicy Bypass -File scripts/deploy-contract.ps1",
    "deploy:sdk": "node --import tsx scripts/deploy-via-sdk.ts",
    "deploy:x402-token": "node --import tsx scripts/deploy-x402-token.ts",
    "enable:staking": "node --import tsx scripts/enable-staking.ts",
    "status": "node --import tsx scripts/check-status.ts",
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p oracle-agent/tsconfig.json && tsc --noEmit -p defi-agent/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "oracle:serve": "npm run serve --workspace oracle-agent",
    "oracle:mcp": "npm run mcp --workspace oracle-agent",
    "oracle:publish": "npm run publish-signal --workspace oracle-agent",
    "oracle:publish-rwa": "npm run publish-rwa --workspace oracle-agent",
    "oracle:resolve": "node --import tsx oracle-agent/src/resolve-signal.ts",
    "rehydrate": "node --import tsx scripts/rehydrate-store-from-chain.ts",
    "cycle": "node --import tsx scripts/run-oracle-cycle.ts",
    "drafts": "node --import tsx scripts/draft-build-in-public-posts.ts",
    "agent:loop": "npm run loop --workspace defi-agent",
    "seed": "node --import tsx scripts/seed-resolved-signals.ts",
    "smoke:x402": "node --import tsx scripts/smoke-x402-local.ts",
    "smoke:mcp": "node --import tsx scripts/smoke-mcp-buys-signal-via-x402.ts",
    "test": "npm run test:agent && npm run test:shared",
    "test:agent": "node --import tsx --test defi-agent/src/reputation-weighted-action.test.ts",
    "test:shared": "node --import tsx --test shared/src/stake-store.test.ts shared/src/chain-signal-reader.test.ts shared/src/chain-stake-reader.test.ts shared/src/calibration.test.ts",
    "test:stake": "node --import tsx --test shared/src/stake-store.test.ts",
    "go-live": "node --import tsx scripts/go-live.ts",
    "demo": "node --import tsx scripts/run-demo.ts",
    "reset": "bash scripts/reset.sh",
    "web:snapshot": "node --import tsx scripts/generate-web-snapshot.ts",
    "web:dev": "npm run dev --workspace web",
    "web:build": "npm run build --workspace web"
  },
  "devDependencies": {
    "binaryen": "^130.0.0",
    "express-rate-limit": "^8.5.2",
    "msedge-tts": "^2.0.7",
    "playwright": "^1.61.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
